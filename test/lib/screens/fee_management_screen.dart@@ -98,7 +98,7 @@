}

/// A view to display and manage fee structures.
class FeeStructuresView extends StatefulWidget {
  const FeeStructuresView({super.key});

  @override
  State<FeeStructuresView> createState() => _FeeStructuresViewState();
}

enum _SortOption { date, name, amountAsc, amountDesc }

class _FeeStructuresViewState extends State<FeeStructuresView> {
  final _searchController = TextEditingController();
  String _searchQuery = '';
  _SortOption _sortOption = _SortOption.date;

  @override
  void initState() {
    super.initState();
    _searchController.addListener(() {
      setState(() {
        _searchQuery = _searchController.text.toLowerCase();
      });
    });
  }

  @override
  void dispose() {
    _searchController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final schoolId = Provider.of<UserDataProvider>(
      context,
      listen: false,
    ).userProfile!.school!.id;
    final feeService = FeeService();

    return Scaffold(
      body: Column(
        children: [
          Padding(
            padding: const EdgeInsets.fromLTRB(12, 12, 12, 8),
            child: TextField(
              controller: _searchController,
              decoration: InputDecoration(
                hintText: 'Search by name...',
                prefixIcon: const Icon(Icons.search),
                border: OutlineInputBorder(
                  borderRadius: BorderRadius.circular(12),
                ),
                suffixIcon: _searchQuery.isNotEmpty
                    ? IconButton(
                        icon: const Icon(Icons.clear),
                        onPressed: () => _searchController.clear(),
                      )
                    : null,
              ),
            ),
          ),
          Padding(
            padding: const EdgeInsets.symmetric(horizontal: 12.0),
            child: Wrap(
              spacing: 8.0,
              children: [
                ChoiceChip(
                  label: const Text('Date'),
                  selected: _sortOption == _SortOption.date,
                  onSelected: (selected) {
                    if (selected) {
                      setState(() => _sortOption = _SortOption.date);
                    }
                  },
                ),
                ChoiceChip(
                  label: const Text('Name'),
                  selected: _sortOption == _SortOption.name,
                  onSelected: (selected) {
                    if (selected) {
                      setState(() => _sortOption = _SortOption.name);
                    }
                  },
                ),
                ChoiceChip(
                  label: const Text('Amount (Low-High)'),
                  selected: _sortOption == _SortOption.amountAsc,
                  onSelected: (selected) {
                    if (selected) {
                      setState(() => _sortOption = _SortOption.amountAsc);
                    }
                  },
                ),
                ChoiceChip(
                  label: const Text('Amount (High-Low)'),
                  selected: _sortOption == _SortOption.amountDesc,
                  onSelected: (selected) {
                    if (selected) {
                      setState(() => _sortOption = _SortOption.amountDesc);
                    }
                  },
                ),
              ],
            ),
          ),
          Expanded(
            child: StreamBuilder<List<FeeStructure>>(
              stream: feeService.getFeeStructures(schoolId).map(
                    (snapshot) => snapshot.docs
                        .map((doc) => FeeStructure.fromMap(doc.data() as Map<String, dynamic>, doc.id))
                        .toList(),
                  ),
              builder: (context, snapshot) {
                if (snapshot.connectionState == ConnectionState.waiting) {
                  return const Center(child: CircularProgressIndicator());
                }
                if (snapshot.hasError) {
                  return Center(child: Text('Error: ${snapshot.error}'));
                }
                if (!snapshot.hasData || snapshot.data!.isEmpty) {
                  return const Center(child: Text('No fee structures found.'));
                }

                final structures = snapshot.data!
                    .where((structure) =>
                        structure.name.toLowerCase().contains(_searchQuery))
                    .toList();

                // Apply sorting
                structures.sort((a, b) {
                  switch (_sortOption) {
                    case _SortOption.name:
                      return a.name
                          .toLowerCase()
                          .compareTo(b.name.toLowerCase());
                    case _SortOption.amountAsc:
                      return a.amount.compareTo(b.amount);
                    case _SortOption.amountDesc:
                      return b.amount.compareTo(a.amount);
                    case _SortOption.date:
                      return b.createdAt.compareTo(a.createdAt);
                  }
                });

                if (structures.isEmpty && _searchQuery.isNotEmpty) {
                  return Center(
                    child: Text('No results found for "$_searchQuery"'),
                  );
                }

                return ListView.builder(
                  itemCount: structures.length,
                  itemBuilder: (context, index) {
                    final structure = structures[index];
                    return Card(
                      margin: const EdgeInsets.symmetric(
                          horizontal: 12, vertical: 6),
                      child: InkWell(
                        onTap: () => _showEditClassesDialog(
                          context,
                          feeService,
                          schoolId,
                          structure,
                        ),
                        child: ListTile(
                          title: Text(structure.name),
                          subtitle: Column(
                            crossAxisAlignment: CrossAxisAlignment.start,
                            children: [
                              Text(structure.description),
                              Text(
                                'Applies to: ${structure.applicableClasses?.isEmpty ?? true ? 'All Classes' : structure.applicableClasses!.join(', ')}',
                                style: Theme.of(context).textTheme.bodySmall,
                              ),
                            ],
                          ),
                          trailing: Row(
                            mainAxisSize: MainAxisSize.min,
                            children: [
                              Text(
                                NumberFormat.currency(symbol: 'UGX ')
                                    .format(structure.amount),
                                style: const TextStyle(
                                    fontWeight: FontWeight.bold),
                              ),
                              PopupMenuButton<String>(
                                onSelected: (value) {
                                  if (value == 'edit') {
                                    _showEditStructureDialog(context,
                                        feeService, schoolId, structure);
                                  } else if (value == 'delete') {
                                    _showDeleteConfirmationDialog(context,
                                        feeService, schoolId, structure);
                                  }
                                },
                                itemBuilder: (context) => [
                                  const PopupMenuItem(
                                    value: 'edit',
                                    child: Text('Edit'),
                                  ),
                                  const PopupMenuItem(
                                    value: 'delete',
                                    child: Text('Delete'),
                                  ),
                                ],
                              ),
                            ],
                          ),
                        ),
                      ),
                    );
                  },
                );
              },
            ),
          ),
        ],
      ),
      floatingActionButton: FloatingActionButton(
        onPressed: () =>
            _showCreateStructureDialog(context, feeService, schoolId),
        child: const Icon(Icons.add),
      ),
    );
  }

  void _showCreateStructureDialog(
      BuildContext context, FeeService service, String schoolId) {
    // This would contain the implementation for the create dialog
  }

  void _showEditStructureDialog(BuildContext context, FeeService service,
      String schoolId, FeeStructure structure) {
    // This would contain the implementation for the edit dialog
  }

  void _showDeleteConfirmationDialog(BuildContext context, FeeService service,
      String schoolId, FeeStructure structure) {
    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        title: const Text('Delete Fee Structure'),
        content: Text(
            'Are you sure you want to delete "${structure.name}"? This action cannot be undone.'),
        actions: [
          TextButton(
            onPressed: () => Navigator.of(context).pop(),
            child: const Text('Cancel'),
          ),
          ElevatedButton(
            style: ElevatedButton.styleFrom(backgroundColor: Colors.red),
            onPressed: () async {
              await service.deleteFeeStructure(schoolId, structure.id);
              if (context.mounted) Navigator.of(context).pop();
            },
            child: const Text('Delete'),
          ),
        ],
      ),
    );
  }

  void _showEditClassesDialog(
    BuildContext context,
    FeeService service,
    String schoolId,
    FeeStructure structure,
  ) {
    final Set<String> selectedClasses =
        (structure.applicableClasses ?? []).toSet();
    final allClassNames = Provider.of<UserDataProvider>(context, listen: false)
        .userProfile!.school!
        .allClassNamesWithStreams;

    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        title: Text('Assign Classes for ${structure.name}'),
        content: StatefulBuilder(
          builder: (context, setDialogState) {
            return SingleChildScrollView(
              child: Wrap(
                spacing: 8.0,
                children: allClassNames.map((className) {
                  final isSelected = selectedClasses.contains(className);
                  return FilterChip(
                    label: Text(className),
                    selected: isSelected,
                    onSelected: (selected) {
                      setDialogState(() {
                        if (selected) {
                          selectedClasses.add(className);
                        } else {
                          selectedClasses.remove(className);
                        }
                      });
                    },
                  );
                }).toList(),
              ),
            );
          },
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.of(context).pop(),
            child: const Text('Cancel'),
          ),
          ElevatedButton(
            onPressed: () async {
              await service.updateFeeStructure(schoolId, structure.id, {'applicableClasses': selectedClasses.toList()});
              if (context.mounted) Navigator.of(context).pop();
            },
            child: const Text('Save'),
          ),
        ],
      ),
    );
  }
}

/// A view to record a new payment for a student.
class RecordPaymentView extends StatefulWidget {
  const RecordPaymentView({super.key});

  @override
  State<RecordPaymentView> createState() => _RecordPaymentViewState();
}

class _RecordPaymentViewState extends State<RecordPaymentView> {
  final _formKey = GlobalKey<FormState>();
  final _studentService = StudentService();
  final _feeService = FeeService();
  bool _isLoading = false;

  // Form state
  Student? _selectedStudent;
  final _amountController = TextEditingController();
  FeeBalance? _feeBalance;
  bool _isBalanceLoading = false;
  String? _paymentMethod;
  DateTime _paymentDate = DateTime.now();

  Future<List<Student>> _searchStudents(String pattern) async {
    if (pattern.isEmpty) return [];
    final schoolId = Provider.of<UserDataProvider>(
      context,
      listen: false,
    ).userProfile!.school!.id;
    return await _studentService.searchStudents(
      schoolId: schoolId,
      nameQuery: pattern,
    );
  }

  Future<void> _fetchStudentBalance(Student student) async {
    setState(() {
      _selectedStudent = student;
      _isBalanceLoading = true;
      _feeBalance = null; // Clear previous balance
    });

    try {
      final schoolId =
          Provider.of<UserDataProvider>(context, listen: false).school!.id;
      final balance = await _feeService.getStudentFeeBalance(student.id);
      if (mounted) {
        setState(() => _feeBalance = balance);
      }
    } finally {
      if (mounted) {
        setState(() => _isBalanceLoading = false);
      }
    }
  }

  Future<void> _pickDate() async {
    final pickedDate = await showDatePicker(
      context: context,
      initialDate: _paymentDate,
      firstDate: DateTime(2000),
      // Prevent payments from being recorded for a future date.
      lastDate: DateTime.now(),
    );
    if (pickedDate != null && pickedDate != _paymentDate) {
      setState(() {
        _paymentDate = pickedDate;
      });
    }
  }

  void _recordPayment() async {
    if (!_formKey.currentState!.validate() || _selectedStudent == null) {
      ScaffoldMessenger.of(
        context,
      ).showSnackBar(const SnackBar(content: Text('Please fill all fields.')));
      return;
    }
    setState(() => _isLoading = true);

    final userData = Provider.of<UserDataProvider>(context, listen: false);

    try {
      await _feeService.recordPayment({
        'schoolId': userData.userProfile!.school!.id,
        'studentId': _selectedStudent!.id,
        'amountPaid': double.parse(_amountController.text),
        'paymentMethod': _paymentMethod!,
        'recordedById': userData.userProfile!.uid,
        'recordedByName':
            '${userData.userProfile!.firstName} ${userData.userProfile!.lastName}'
                .trim(),
        'paymentDate': _paymentDate.toIso8601String(),
      });

      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(content: Text('Payment recorded successfully!')),
        );
        _formKey.currentState!.reset();
        setState(() {
          _selectedStudent = null;
          _amountController.clear();
          _paymentMethod = null;
          _feeBalance = null;
          _paymentDate = DateTime.now(); // Reset date
        });
      }
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(
          context,
        ).showSnackBar(SnackBar(content: Text('Failed to record payment: $e')));
      }
    } finally {
      if (mounted) setState(() => _isLoading = false);
    }
  }

  @override
  Widget build(BuildContext context) {
    return SingleChildScrollView(
      padding: const EdgeInsets.all(16.0),
      child: Form(
        key: _formKey,
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(
              'Record Student Payment',
              style: Theme.of(context).textTheme.headlineSmall,
            ),
            const SizedBox(height: 24),
            // Student Search Autocomplete
            Autocomplete<Student>(
              displayStringForOption: (student) => student.fullName,
              optionsBuilder: (textEditingValue) {
                return _searchStudents(textEditingValue.text);
              },
              onSelected: _fetchStudentBalance,
              fieldViewBuilder:
                  (context, controller, focusNode, onFieldSubmitted) {
                return TextFormField(
                  controller: controller,
                  focusNode: focusNode,
                  decoration: InputDecoration(
                    labelText: 'Search for Student',
                    border: const OutlineInputBorder(),
                    suffixIcon: _selectedStudent != null
                        ? const Icon(
                            Icons.check_circle,
                            color: Colors.green,
                          )
                        : null,
                  ),
                  validator: (v) => _selectedStudent == null
                      ? 'Please select a student'
                      : null,
                );
              },
            ),
            const SizedBox(height: 16),

            // Balance Display Section
            if (_isBalanceLoading)
              const Center(
                child: Padding(
                  padding: EdgeInsets.all(8.0),
                  child: CircularProgressIndicator(),
                ),
              ),
            if (_feeBalance != null)
              Container(
                width: double.infinity,
                padding: const EdgeInsets.all(12),
                decoration: BoxDecoration(
                  // ignore: deprecated_member_use
                  color: Colors.blue.withOpacity(0.1),
                  borderRadius: BorderRadius.circular(8.0),
                ),
                child: Text(
                  'Current Balance: ${NumberFormat.currency(symbol: 'UGX ').format(_feeBalance!.balance)}',
                  textAlign: TextAlign.center,
                  style: TextStyle(
                    fontWeight: FontWeight.bold,
                    color: _feeBalance!.balance > 0 ? Colors.red : Colors.green,
                  ),
                ),
              ),
            TextFormField(
              controller: _amountController,
              decoration: const InputDecoration(
                labelText: 'Amount Paid',
                border: OutlineInputBorder(),
              ),
              keyboardType: TextInputType.number,
              validator: (value) {
                if (value == null || value.isEmpty) {
                  return 'Amount is required';
                }
                final amount = double.tryParse(value);
                if (amount == null) {
                  return 'Please enter a valid number.';
                }
                if (amount <= 0) {
                  return 'Amount must be positive.';
                }
                if (_feeBalance != null &&
                    _feeBalance!.balance > 0 &&
                    amount > _feeBalance!.balance) {
                  return 'Payment cannot exceed the balance.';
                }
                return null;
              },
            ),
            const SizedBox(height: 16),
            DropdownButtonFormField<String>(
              initialValue: _paymentMethod,
              hint: const Text('Payment Method'),
              onChanged: (value) => setState(() => _paymentMethod = value),
              items: [
                'Bank Deposit',
                'Cash',
                'Mobile Money',
              ].map((m) => DropdownMenuItem(value: m, child: Text(m))).toList(),
              validator: (v) => v == null ? 'Please select a method' : null,
              decoration: const InputDecoration(border: OutlineInputBorder()),
            ),
            const SizedBox(height: 16),
            TextFormField(
              readOnly: true,
              controller: TextEditingController(
                text: DateFormat.yMMMd().format(_paymentDate),
              ),
              decoration: const InputDecoration(
                labelText: 'Payment Date',
                border: OutlineInputBorder(),
                suffixIcon: Icon(Icons.calendar_today),
              ),
              onTap: _pickDate,
            ),
            const SizedBox(height: 32),
            LoadingButton(
              isLoading: _isLoading,
              onPressed: _recordPayment,
              text: 'Record Payment',
            ),
          ],
        ),
      ),
    );
  }
}
